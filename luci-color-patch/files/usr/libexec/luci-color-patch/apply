			if (match(s, /o[[:space:]]*\.[[:space:]]*default[[:space:]]*=[[:space:]]*'\''blue'\''[[:space:]]*;/)) {
				s = substr(s, RSTART + RLENGTH)
				skip_mode = ""
				return s
			}

			return ""
		}
		function strip_list_tail(s) {
			if (match(s, /o[[:space:]]*\.[[:space:]]*value[[:space:]]*\([[:space:]]*'\''orange'\''[^;]*;/)) {
				s = substr(s, RSTART + RLENGTH)
				skip_mode = ""
				return s
			}

			return ""
		}
		function repair_broken_ntp_prefix(s) {

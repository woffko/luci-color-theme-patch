remove_css_patch_blocks() {
	tmp="$CASCADE_CSS.tmp.$$"
	awk '
		/\/\* luci-colorpatch-v[0-9]+ \*\// {
			skip = 1
			next
		}

		skip && /\/\* \/luci-colorpatch-v[0-9]+ \*\// {
			skip = 0
			next
		}

		!skip {
			print
		}

		END {
			if (skip)
				exit 1
		}
	' "$CASCADE_CSS" > "$tmp" || {
		rm -f "$tmp"
		echo "Failed to remove previous luci-color-patch CSS block from $CASCADE_CSS" >&2
		exit 1
	}

	mv "$tmp" "$CASCADE_CSS"
}

patch_luci_config() {
	if grep -qE '^[[:space:]]*option[[:space:]]+accent[[:space:]]+' "$LUCI_CFG"; then
		return
	fi

	tmp="$LUCI_CFG.tmp.$$"
	awk '
		$1 == "config" && $2 == "core" && $3 == "main" { in_main = 1 }
		in_main && $1 == "config" && !($2 == "core" && $3 == "main") && !done {
			print "\toption accent blue"
			done = 1
			in_main = 0
		}
		{
			print
		}
		END {
			if (in_main && !done)
				print "\toption accent blue"
		}
	' "$LUCI_CFG" > "$tmp"
	mv "$tmp" "$LUCI_CFG"
}


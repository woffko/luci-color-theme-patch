.luci-color-palette-wrap {
	max-width: 430px;
}

.luci-color-palette {
	display: grid;
	grid-template-columns: repeat(auto-fill, 30px);
	gap: 6px;
	align-items: center;
}

.luci-color-swatch {
	position: relative;
	width: 30px;
	height: 30px;
	border: 1px solid var(--border-color-medium);
	border-radius: 6px;
	background: linear-gradient(135deg, var(--swatch-high) 0 50%, var(--swatch-medium) 50% 100%);
	box-shadow: inset 0 0 0 1px hsla(var(--background-color-high-hsl), .22);
	cursor: pointer;
}

.luci-color-swatch::after {
	content: "";
	position: absolute;
	left: 10px;
	top: 6px;
	width: 7px;
	height: 13px;
	border: solid var(--swatch-text);
	border-width: 0 2px 2px 0;
	opacity: 0;
	transform: rotate(45deg);
}

.luci-color-swatch:hover,
.luci-color-swatch:focus {
	border-color: var(--text-color-high);
}

.luci-color-swatch.selected {
	outline: 2px solid var(--text-color-highest);
	outline-offset: 2px;
	border-color: var(--background-color-high);
}

.luci-color-swatch.selected::after {
	opacity: 1;
}

.luci-color-swatch:disabled {
	cursor: default;
	opacity: var(--disabled-opacity);
}

header {
	color: var(--header-link-color);
	background: linear-gradient(var(--header-background-high), var(--header-background-low));
	box-shadow: 0 1px 3px var(--header-shadow-color), inset 0 -1px 0 hsla(var(--border-color-low-hsl), .01);
}

header a {

			print "\t\t\to.uciconfig = '\''luci'\'';"
			print "\t\t\to.ucisection = '\''main'\'';"
			print "\t\t\to.ucioption = '\''tablefilters'\'';"
			print ""
			print "\t\t\t/*"
			print "\t\t\t * NTP"
			print "\t\t\t */"
			print ""
			print "\t\t\tif (L.hasSystemFeature('\''sysntpd'\'')) {"
			print "\t\t\t\tvar default_servers = ["
			print "\t\t\t\t\t'\''0.openwrt.pool.ntp.org'\'', '\''1.openwrt.pool.ntp.org'\'',"
			print "\t\t\t\t\t'\''2.openwrt.pool.ntp.org'\'', '\''3.openwrt.pool.ntp.org'\''"
			print "\t\t\t\t];"
			print ""
			print "\t\t\t\to = s.taboption('\''timesync'\'', form.Flag, '\''enabled'\'', _('\''Enable NTP client'\''));"
			print "\t\t\t\to.rmempty = false;"
			print "\t\t\t\to.ucisection = '\''ntp'\'';"
			print "\t\t\t\to.default = o.disabled;"
			print "\t\t\t\to.write = function(section_id, value) {"
			print "\t\t\t\t\tntpd_enabled = +value;"
			print ""
			print "\t\t\t\t\tif (ntpd_enabled && !uci.get('\''system'\'', '\''ntp'\'')) {"
			print "\t\t\t\t\t\tuci.add('\''system'\'', '\''timeserver'\'', '\''ntp'\'');"
			print "\t\t\t\t\t\tuci.set('\''system'\'', '\''ntp'\'', '\''server'\'', default_servers);"
			print "\t\t\t\t\t}"

			repaired_ntp = 1
			seen_ntp_enabled = 1
		}
		{
			line = $0
			gsub(/\/\*[[:space:]]*luci-colorpatch-system-v[0-9]+[[:space:]]*\*\//, "", line)
			gsub(/const[[:space:]]+luciColorPatchSystemMarker[[:space:]]*=[^;]*;/, "", line)
			if (line == "")
				next

			while (1) {
				if (skip_mode == "palette") {
					line = strip_palette_tail(line)
					if (skip_mode != "")
						next
					if (line == "")
						next
					continue
				}

				if (skip_mode == "list") {
					line = strip_list_tail(line)
					if (skip_mode != "")
						next
					if (line == "")
						next
					continue
				}

				if (match(line, /const[[:space:]]+accentPaletteChoices[[:space:]]*=[[:space:]]*\[/)) {
					prefix = substr(line, 1, RSTART - 1)
					if (has_theme_value(prefix))
						theme_value_seen = 1
					if (prefix !~ /^[[:space:]]*$/)
						print prefix
					if (!theme_value_seen)
						print_theme_value()

					print_block_once()
					skip_mode = "palette"
					line = substr(line, RSTART)
					line = strip_palette_tail(line)
					if (skip_mode != "")
						next
					if (line == "")
						next
					continue
				}

				if (!done && match(line, /o[[:space:]]*\.[[:space:]]*value[[:space:]]*\([[:space:]]*uci[[:space:]]*\.[[:space:]]*get[[:space:]]*\([[:space:]]*'\''luci'\''[[:space:]]*,[[:space:]]*'\''themes'\''[[:space:]]*,[[:space:]]*t[[:space:]]*\)[[:space:]]*,[[:space:]]*t[[:space:]]*\)[[:space:]]*;/)) {
					print substr(line, 1, RSTART + RLENGTH - 1)
					theme_value_seen = 1
					print_block_once()
					line = substr(line, RSTART + RLENGTH)
					if (line == "")
						next
					continue
				}

				if (line ~ /o[[:space:]]*=[[:space:]]*s[[:space:]]*\.[[:space:]]*taboption[[:space:]]*\([[:space:]]*'\''language'\''[[:space:]]*,[[:space:]]*form[[:space:]]*\.[[:space:]]*ListValue[[:space:]]*,[[:space:]]*'\''_accent'\''/) {
					print_block_once()
					skip_mode = "list"
					line = strip_list_tail(line)
					if (skip_mode != "")
						next
					if (line == "")
						next
					continue
				}

				break
			}

			if (line ~ /s[[:space:]]*\.[[:space:]]*taboption[[:space:]]*\([[:space:]]*'\''timesync'\''[[:space:]]*,[[:space:]]*form[[:space:]]*\.[[:space:]]*Flag[[:space:]]*,[[:space:]]*'\''enabled'\''/)
				seen_ntp_enabled = 1
			if (has_theme_value(line))
				theme_value_seen = 1

			repair_broken_ntp_prefix(line)
			print line
		}
		END {
			if (!done || !theme_value_seen)
				exit 1
		}
	' "$SYSTEM_JS" > "$tmp" || {
		rm -f "$tmp"
		echo "Failed to inject accent selector into $SYSTEM_JS" >&2
		exit 1
	}

	if ! system_js_has_theme_selector "$tmp" || ! grep -q "$SYSTEM_STAMP" "$tmp"; then
		rm -f "$tmp"
		echo "Failed to validate the LuCI system patch in $SYSTEM_JS" >&2
		exit 1
	fi

	mv "$tmp" "$SYSTEM_JS"
}

patch_header_ut() {
	if ! grep -q 'const safeaccents = {' "$HEADER_UT" || ! grep -q 'olive: true' "$HEADER_UT"; then
		tmp="$HEADER_UT.tmp.$$"
		accent_block=$(cat <<'EOF'
	const accent = uci.get('luci', 'main', 'accent');
	const safeaccents = {
		blue: true, sky: true, cyan: true, teal: true,
		emerald: true, green: true, mint: true, lime: true,
		yellow: true, amber: true, orange: true, coral: true,
		red: true, rose: true, pink: true, fuchsia: true,
		purple: true, violet: true, indigo: true, navy: true,
		slate: true, zinc: true, stone: true, brown: true,
		white: true, silver: true, gray: true, charcoal: true,
		black: true, cream: true, sand: true, tan: true,
		gold: true, tangerine: true, scarlet: true, crimson: true,
		maroon: true, orchid: true, plum: true, mauve: true,
		lavender: true, periwinkle: true, cobalt: true, azure: true,
		ocean: true, petrol: true, forest: true, olive: true
	};
	const safeaccent = safeaccents[accent] ? accent : 'blue';
EOF
)

		awk -v block="$accent_block" '
			{
				if ($0 ~ /const accent = uci\.get\('\''luci'\'',[[:space:]]*'\''main'\'',[[:space:]]*'\''accent'\''\);/) {
					if (!done_block) {
						print block
						done_block = 1
					}
					done_block = 1
					skip = 1
					next
				}

				if (skip) {
					if ($0 ~ /\)[[:space:]]*\?[[:space:]]*accent[[:space:]]*:[[:space:]]*'\''blue'\'';/ || $0 ~ /const safeaccent = safeaccents\[accent\][[:space:]]*\?[[:space:]]*accent[[:space:]]*:[[:space:]]*'\''blue'\'';/)
						skip = 0
					next
				}

				print

				if ($0 ~ /const darkpref = / && !done_block) {
					print block
					done_block = 1
				}
			}
			END {
				if (!done_block)
					exit 1
			}
		' "$HEADER_UT" > "$tmp" || {
			rm -f "$tmp"
			echo "Failed to inject accent validation into $HEADER_UT" >&2
			exit 1
		}

		mv "$tmp" "$HEADER_UT"
	fi

	grep -q 'data-accent="{{ safeaccent }}"' "$HEADER_UT" && return

	tmp="$HEADER_UT.tmp.$$"
	awk '
		{
			line = $0

			if (!done && line ~ /<html[[:space:]]+lang="\{\{ dispatcher\.lang \}\}"/) {
				if (line !~ /data-accent="\{\{ safeaccent \}\}"/)
					sub(/<html[[:space:]]+lang="\{\{ dispatcher\.lang \}\}"/, "& data-accent=\"{{ safeaccent }}\"", line)

				done = 1
			}

			print line
		}
		END {
			if (!done)
				exit 1
		}
	' "$HEADER_UT" > "$tmp" || {
		rm -f "$tmp"
		echo "Failed to inject data-accent into $HEADER_UT" >&2
		exit 1
	}

	mv "$tmp" "$HEADER_UT"
}

patch_cascade_css() {
	remove_css_patch_blocks
	append_css_patch
}

restart_services() {
	[ "$RESTART_SERVICES" = "1" ] || return 0

	command -v uci >/dev/null 2>&1 && uci commit luci || true
	[ -x "$ROOT/etc/init.d/uhttpd" ] && "$ROOT/etc/init.d/uhttpd" restart || true
	rm -f "$ROOT/tmp/luci-indexcache" 2>/dev/null || true
}

main() {
	require_file "$LUCI_CFG"
	require_file "$SYSTEM_JS"
	require_file "$HEADER_UT"
	require_file "$CASCADE_CSS"

	backup_file "$LUCI_CFG"
	backup_file "$SYSTEM_JS"
	backup_file "$HEADER_UT"
	backup_file "$CASCADE_CSS"

	patch_luci_config
	patch_system_js
	patch_header_ut
	patch_cascade_css
	restart_services

	echo "LuCI color patch applied."
	echo "Theme support: bootstrap"
	echo "Config option: luci.main.accent"
}

if [ "${LUCI_COLOR_PATCH_LIBRARY_ONLY:-0}" != "1" ]; then
	main "$@"
fi

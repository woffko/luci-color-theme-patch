#!/bin/sh

PKG="luci-color-patch"
CACHE_DIR="/etc/luci-color-patch"
CACHE_APK="$CACHE_DIR/luci-color-patch.apk"
EMBEDDED_APK="/usr/share/luci-color-patch/luci-color-patch.apk"
APPLY="/usr/libexec/luci-color-patch/apply"

log() {
	echo "$PKG: $*" >&2
}

cache_apk() {
	mkdir -p "$CACHE_DIR" || return 1

	if [ "${1:-}" != "force" ] && [ -f "$CACHE_APK" ]; then
		return 0
	fi

	if [ -f "$EMBEDDED_APK" ]; then
		cp -fp "$EMBEDDED_APK" "$CACHE_APK" || return 1
	fi

	[ -f "$CACHE_APK" ]
}

is_installed() {
	command -v apk >/dev/null 2>&1 || return 1
	apk info -e "$PKG" >/dev/null 2>&1 && return 0
	apk list --installed "$PKG" 2>/dev/null | grep -q "^$PKG-" && return 0
	return 1
}

reinstall_pkg() {
	command -v apk >/dev/null 2>&1 || {
		log "apk is not available"
		return 1
	}

	[ -f "$CACHE_APK" ] || {
		log "cached APK is missing: $CACHE_APK"
		return 1
	}

	LUCI_COLOR_PATCH_SELF_REINSTALL=1 apk add --allow-untrusted --force-overwrite "$CACHE_APK"
}

apply_patch() {
	[ -x "$APPLY" ] || return 0
	NO_BACKUP="${NO_BACKUP:-1}" RESTART_SERVICES="${RESTART_SERVICES:-0}" "$APPLY"
}

case "${1:-}" in
	--cache-only)
		cache_apk || log "unable to cache APK"
		exit 0
		;;
	--refresh-cache)
		cache_apk force || log "unable to refresh APK cache"
		exit 0
		;;
	--apply-only)
		apply_patch || true
		exit 0
		;;
esac

cache_apk || log "continuing without refreshed APK cache"

if ! is_installed; then
	reinstall_pkg || log "self-reinstall failed"
fi

apply_patch || true

exit 0
